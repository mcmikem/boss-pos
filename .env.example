# DATABASE_URL: Required. Postgres connection string (Neon) used by the API.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# AUTH_SECRET: Required. Secret used to sign API auth tokens.
# Rotating it invalidates all existing till sessions (tills must re-enter the PIN once).
AUTH_SECRET="MY_AUTH_SECRET"

# CRON_SECRET: Optional bearer token that guards the scheduled daily-backup
# endpoint (/api/cron/backup). Set the same value in the Vercel cron headers so
# the backup endpoint is never publicly triggerable.
CRON_SECRET="MY_CRON_SECRET"
